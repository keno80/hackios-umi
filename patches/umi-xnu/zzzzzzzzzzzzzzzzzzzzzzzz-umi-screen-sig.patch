+/*
+	 * UMI bring-up: the repeat signature below is a content hash, not the
+	 * address of the message. Probes build their text in one shared stack buffer,
+	 * so comparing pointers collapsed genuinely different lines into a single
+	 * counted line. Identical text still folds, so spin loops stay quiet.
+	 */
+static unsigned long
+umi_scr_text_hash(const char *umi_text)
+{
+	unsigned long umi_hash = 14695981039346656037UL;
+
+	if (umi_text == NULL) {
+		return 0;
+	}
+	for (; *umi_text != '\0'; umi_text++) {
+		umi_hash = (umi_hash ^ (unsigned long) (unsigned char) *umi_text) *
+		    1099511628211UL;
+	}
+	return umi_hash;
+}
