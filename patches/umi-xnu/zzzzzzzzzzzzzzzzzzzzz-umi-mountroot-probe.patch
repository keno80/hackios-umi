--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1,4 +1,5 @@
 #include <kern/boot_progress.h>
+#include <libkern/libkern.h>	/* UMI bring-up probe: snprintf */
 /*
  * Copyright (c) 2000-2021 Apple Inc. All rights reserved.
  *
@@ -1006,6 +1007,18 @@
 	inittodr(0);
 
 	/* Mount the root file system. */
+	/* UMI bring-up: PE_boot_args() is the only place the loader's rd= can be
+	 * checked, and printf() never reaches this panel. */
+	{
+		char umi_msg[200];
+		char umi_cmd[160];
+		const char *umi_args = (const char *)PE_boot_args();
+
+		(void)strlcpy(umi_cmd, (umi_args != NULL) ? umi_args : "(null)",
+		    sizeof(umi_cmd));
+		(void)snprintf(umi_msg, sizeof(umi_msg), "CMDLINE %s", umi_cmd);
+		boot_progress_stage(umi_msg);
+	}
 	while (TRUE) {
 		int err;
 
@@ -1036,6 +1049,14 @@
 		}
 #endif
 		printf("cannot mount root, errno = %d\n", err);
+		{
+			char umi_msg[160];
+
+			(void)snprintf(umi_msg, sizeof(umi_msg),
+			    "MOUNTFAIL err=%d rootdev=0x%x rd=%s", err,
+			    (unsigned int)rootdev, (rootdevice[0] != '\0') ? rootdevice : "(empty)");
+			boot_progress_stage(umi_msg);
+		}
 	}
 
 	IOSecureBSDRoot(rootdevice);
@@ -1346,6 +1367,17 @@
 		flags = 0;
 	}
 
+	/* UMI bring-up: setconf() is the only writer of rootdev before the first
+	 * bdevvp(), and its fallback silently renames the root to sd0a. */
+	{
+		char umi_msg[160];
+
+		(void)snprintf(umi_msg, sizeof(umi_msg),
+		    "SETCONF iombr=%d rootdev=0x%x rd=%s", (int)err,
+		    (unsigned int)rootdev, (rootdevice[0] != '\0') ? rootdevice : "(empty)");
+		boot_progress_stage(umi_msg);
+	}
+
 #if CONFIG_NETBOOT
 	if (flags & 1) {
 		/* network device */
--- a/bsd/vfs/vfs_subr.c
+++ b/bsd/vfs/vfs_subr.c
@@ -117,6 +117,8 @@
 #include <machine/machine_routines.h>
 
 #include <kern/assert.h>
+#include <kern/boot_progress.h>	/* UMI bring-up probe: stage strings reach the panel */
+#include <libkern/libkern.h>	/* UMI bring-up probe: snprintf */
 #include <mach/kern_return.h>
 #include <kern/thread.h>
 #include <kern/sched_prim.h>
@@ -1239,6 +1241,13 @@
 	}
 	if ((error = bdevvp(rootdev, &rootvp))) {
 		printf("vfs_mountroot: can't setup bdevvp\n");
+		{
+			char umi_msg[128];
+
+			(void)snprintf(umi_msg, sizeof(umi_msg), "MR bdevvp=%d rootdev=0x%x",
+			    error, (unsigned int)rootdev);
+			boot_progress_stage(umi_msg);
+		}
 
 		KDBG_RELEASE(DBG_MOUNTROOT | DBG_FUNC_END, error, 1);
 		return error;
@@ -1393,8 +1402,20 @@
 		if (error != EINVAL) {
 			printf("%s_mountroot failed: %d\n", vfsp->vfc_name, error);
 		}
+		{
+			char umi_msg[128];
+
+			(void)snprintf(umi_msg, sizeof(umi_msg), "MR %s=%d", vfsp->vfc_name, error);
+			boot_progress_stage(umi_msg);
+		}
 	}
 	KDBG_RELEASE(DBG_MOUNTROOT | DBG_FUNC_END, error ? error : ENODEV, 4);
+	{
+		char umi_msg[128];
+
+		(void)snprintf(umi_msg, sizeof(umi_msg), "MR exhausted last=%d", error);
+		boot_progress_stage(umi_msg);
+	}
 	return ENODEV;
 }
 
